# Copy this file to `.env` (or export the variables in your shell) and fill in the
# real values from your Slack and Jira/Capacity Planner accounts.
# Spring Boot will read these environment variables automatically.

# Slack
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Jira (optional if you still fetch time off from Jira issues)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEYS=VAC # comma-separated if multiple
JIRA_START_FIELD=startDate
JIRA_END_FIELD=endDate
JIRA_REVIEW_STATUS_FIELD=Approved

# Tempo Capacity Planner / Planner API
CAPACITY_PLANNER_BASE_URL=https://api.tempo.io
CAPACITY_PLANNER_TOKEN=your-tempo-api-token
CAPACITY_PLANNER_SCHEDULE_ID=team-schedule-id
CAPACITY_PLANNER_PLANS_PATH=/planning/1/plans
CAPACITY_PLANNER_APPROVED_STATUSES=APPROVED
CAPACITY_PLANNER_TIME_OFF_TYPES=TIME_OFF,ABSENCE

# Application
APP_TIMEZONE=UTC
